<script is:inline>
function pzQuoteSubmit(e) {
  e.preventDefault();
  var f = document.getElementById('pzQuoteForm');
  var btn = f.querySelector('button[type="submit"], button:not([type])');
  var data = Object.fromEntries(new FormData(f).entries());
  data.source = 'website';
  if (btn) { btn.disabled = true; btn.textContent = 'Sending&hellip;'; }
  fetch(f.action, { method: 'POST', body: new URLSearchParams(data) })
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      var panel = document.getElementById('pzQuoteForm');
      panel.innerHTML = '<div style="text-align:center; padding:28px 10px">' +
        '<div style="font-size:40px; line-height:1">&check;</div>' +
        '<div style="font-family:\'Barlow Condensed\',sans-serif; font-weight:800; font-size:24px; text-transform:uppercase; margin-top:10px">Request received</div>' +
        '<div style="color:var(--muted); font-size:14.5px; margin-top:8px">Thanks ' + (data.name ? data.name.split(' ')[0] : '') + ' &mdash; we\'ll call you shortly at ' + (data.phone || 'your number') + '.</div>' +
        '<div style="color:var(--muted); font-size:13px; margin-top:6px">Need help now? Call (714) 926-9413.</div></div>';
    })
    .catch(function (err) {
      console.error('Quote submit failed:', err);
      if (btn) { btn.disabled = false; btn.textContent = 'Request My Quote &rarr;'; }
      alert('Something went wrong sending your request. Please call us instead: (714) 926-9413');
    });
  return false;
}
</script>
