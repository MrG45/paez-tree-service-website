---
import { translate, type Locale } from '../i18n';
import Faq from './Faq.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import QuoteForm from './QuoteForm.astro';
import OptimizedImage from './OptimizedImage.astro';
import TrustBar from './TrustBar.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (text: string) => translate(locale, text);
const heroTaglineParts = t("safe, clean & fast.").split(/([,&.]|\by\b)/);
const mapUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d212122.2119478023!2d-117.9563943461932!3d33.8275470396391!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dcd7ac07d2851d%3A0xc474e8504ab3b629!2sPaez%20tree%20service!5e0!3m2!1sen!2sus!4v1689114466196!5m2!1sen!2sus".replaceAll('!1sen', `!1s${locale}`);
---
<!DOCTYPE html>
<html lang={locale === 'es' ? 'es-MX' : 'en-US'}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preload" href="/assets/fonts/barlow-condensed-v13-800-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/barlow-v13-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<title>{t("Paez Tree Service — Professional Tree Service in Anaheim, CA | Trim • Removal • Stumps • Palms")}</title>
<meta name="description" content={t("Anaheim's trusted tree service for trimming, removal, stumps and palms across all of Orange County. Free estimates, 24/7 emergency response. CA License #1089610. Call (714) 926-9413.")}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'}>
  <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'}>
  <meta property="og:title" content={t("Paez Tree Service — Tree work done safe, clean & fast")}>
  <meta property="og:description" content={t("Free estimates across Anaheim & Orange County. 24/7 emergency tree service. Fully insured. CA License #1089610.")}>
  <meta property="og:image" content="/assets/site/hero-climber.webp">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/fonts.css">
<link rel="preload" as="image" type="image/avif" href="/assets/optimized/site/hero-climber-1280.avif" media="(max-width: 760px)" fetchpriority="high">
<link rel="preload" as="image" type="image/avif" href="/assets/optimized/site/hero-climber-1280.avif" media="(min-width: 760.01px) and (max-width: 940px)" fetchpriority="high">
<link rel="preload" as="image" type="image/avif" href="/assets/optimized/site/hero-climber-1600.avif" media="(min-width: 940.01px)" fetchpriority="high">
<link rel="stylesheet" href="/style.css">
<script is:inline>window.PZ_TPL_URI = '';</script>
<style is:global>
  html { scroll-behavior: smooth; }
  [id] { scroll-margin-top: var(--pz-scroll-offset, 120px); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

</style>
<script defer src="/js/main.js"></script>
<script defer src="/js/site.js"></script>
<script defer src="/js/header.js"></script>
<script defer src="/js/promo.js"></script>
<script defer src="/js/contact-bar.js"></script>
<script defer src="/js/navigation.js"></script>
</head>
<body  style="--forest:var(--brand-green); --pine:var(--brand-green); --moss:var(--brand-green); --leaf:var(--brand-green); --bark:#4f2a0f; --tan:var(--action); --cream:#efe9da; --paper:#f5f2ea; --ink:#242424; --muted:#606060; --line:#e2dccc; --yelp:#d32323; --accent:#9c5a26; font-family:'Barlow',system-ui,sans-serif; color:var(--ink); background:var(--paper); line-height:1.55; overflow-x:hidden">


<a href="#main" class="pz-skip-link">{t("Skip to main content")}</a>

<!-- The offer waits for a clear space after the hero and form. -->
<div id="pzPromo" class="pz-promo" hidden>
  <span class="pz-promo-text">{t("Ask about 10% off")}</span>
  <a href="#quote" class="pz-promo-a">{t("Add to my estimate →")}</a>
  <button type="button" data-promo-close aria-label={t("Dismiss offer")}>&times;</button>
</div>

<Header locale={locale} />

<main id="main" tabindex="-1">
<!-- HERO -->
<section class="pz-hero">
  <div class="pz-hero-inner">
    <div class="pz-hero-copy">
      <div class="pz-hero-badge">
        <svg class="pz-hero-insurance-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 4.5 6v5.5c0 4.3 3 7.5 7.5 9.5 4.5-2 7.5-5.2 7.5-9.5V6L12 3Z"/><path d="m8.5 11.5 2.5 2.5 4.5-5"/></svg>
        {t("Fully Insured · Bonded · Workers' Comp")}
      </div>
      <h1 class="pz-h1">{t("Tree work done")}<br><span>{heroTaglineParts.map((part) => /^[,&.]$|^y$/.test(part) ? <span class="pz-hero-accent">{part}</span> : part)}</span></h1>
      <p class="pz-hero-description"><strong>Paez Tree Service</strong> {t("handles tree trimming, removal, stump grinding and palm care across Anaheim and Orange County. Get a free estimate, with complete cleanup included.")}</p>
      <a class="pz-hero-license" href="#about">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m8.2 13.6-1.2 7.4 5-2.5 5 2.5-1.2-7.4"/><circle cx="12" cy="9" r="6"/><path d="m9.5 9 1.7 1.7 3.3-3.3"/></svg>
        <span>{t("CA State License #1089610")}</span>
      </a>
      <div class="pz-hero-cta">
        <a href="#quote" class="pz-primary-cta">{t("Free estimate")} <span aria-hidden="true">→</span></a>
        <a href="tel:7149269413" class="pz-hero-call">{t("Call (714) 926-9413")}</a>
      </div>
      <div class="pz-hero-proof">
        <a href="#service-area" class="pz-hero-area-link">{t("View service area")} <span aria-hidden="true">→</span></a>
        <a class="pz-proof-link" href="https://www.yelp.com/biz/paez-tree-service-anaheim" target="_blank" rel="noopener">{t("Read customer reviews on")} <img src="/assets/optimized/yelp-logo-white-192.webp" alt="Yelp" width="44" height="22"></a>
      </div>
    </div>

    <QuoteForm locale={locale} />
  </div>
</section>

<!-- TRUST STRIP -->
<TrustBar locale={locale} />

<!-- SERVICES -->
<section id="services" class="pz-sec" style="max-width:1180px; margin:0 auto; padding:84px 24px 76px">
  <div style="text-align:center; margin-bottom:48px">
    <div style="color:var(--accent); font-weight:700; letter-spacing:.18em; text-transform:uppercase; font-size:14px; margin-bottom:10px">{t("Our Services")}</div>
    <h2 class="pz-h2" style="font-family:'Barlow Condensed',sans-serif; font-weight:800; font-size:46px; text-transform:uppercase; letter-spacing:.01em; margin:0; color:var(--forest)">{t("Everything your trees need")}</h2>
    <p style="color:var(--muted); font-size:17px; max-width:620px; margin:14px auto 0">{t("From routine trimming to full removals and emergency storm work one crew, fully equipped, every job cleaned up.")}</p>
  </div>
  <div class="pz-grid3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:26px">

    <a href="#quote" class="pz-card" data-service-select="Tree Trimming" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block; box-shadow:0 1px 0 rgba(0,0,0,.02)">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-trimming-v2.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("Tree Trimming")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Pruning, lacing & thinning to keep trees healthy, shaped and safe from your roof and power lines.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

    <a href="#quote" class="pz-card" data-service-select="Tree Removal" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-removal-v3.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("Tree Removal")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Safe, controlled removal of trees of any size — even tight spots against walls and property lines.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

    <a href="#quote" class="pz-card" data-service-select="Stump Removal" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-stump-v3.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("Stump Removal")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Grinding and full removal to reclaim your yard, improve safety and stop regrowth and pests.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

    <a href="#quote" class="pz-card" data-service-select="Palm Tree Service" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-palm-v2.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("Palm Tree Service")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Skinning, trimming and cleaning to keep palms healthy, tidy and free of fire prone dead fronds.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

    <a href="#quote" class="pz-card" data-service-select="HOA / Commercial" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-hoa-v2.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("HOA Tree Work")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Reliable, scheduled maintenance that keeps your community's trees safe, uniform and looking great.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

    <a href="#quote" class="pz-card" data-service-select="HOA / Commercial" data-promo-protect style="text-decoration:none; color:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; overflow:hidden; display:block">
      <div style="overflow:hidden"><OptimizedImage src="/assets/generated/paez-commercial-v3.png" alt="" class="pz-card-img" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1024px) calc(50vw - 36px), 360px" style="width:100%; height:190px; object-fit:cover; display:block" /></div>
      <div style="padding:22px 22px 24px">
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:24px; text-transform:uppercase; margin:0 0 8px; color:var(--forest)">{t("Commercial Tree Work")}</h3>
        <p style="color:var(--muted); font-size:15px; margin:0 0 14px">{t("Professional crews and equipment for property managers, businesses and large scale grounds.")}</p>
        <span style="color:var(--accent); font-weight:700; font-size:14.5px; text-transform:uppercase; letter-spacing:.04em">{t("Get an estimate →")}</span>
      </div>
    </a>

  </div>
</section>

<!-- BEFORE / AFTER + GALLERY -->
<section id="work" aria-labelledby="pz-work-title" style="background:radial-gradient(130% 90% at 50% -10%, #155730 0%, rgba(21,87,48,0) 55%), linear-gradient(180deg, #0c3c21 0%, #072512 100%)">
  <div class="pz-sec" style="max-width:1180px; margin:0 auto; padding:84px 24px 76px">
  <div data-promo-protect style="text-align:center; margin-bottom:42px">
    <div style="color:var(--tan); font-weight:700; letter-spacing:.18em; text-transform:uppercase; font-size:14px; margin-bottom:10px">{t("Recent Work")}</div>
    <h2 id="pz-work-title" class="pz-h2" style="font-family:'Barlow Condensed',sans-serif; font-weight:800; font-size:46px; text-transform:uppercase; margin:0; color:#fff">{t("Real trees. Visible results.")}</h2>
    <p style="color:#d6d6d6; font-size:17px; max-width:560px; margin:14px auto 0">{t("Before-and-after photos from Paez Tree Service. Compare the work, then explore more of our projects.")}</p>
  </div>
  <figure class="pz-featured-work" data-promo-protect>
  <div class="rv rv-rise" data-cmp style="position:relative; border-radius:12px; overflow:hidden; box-shadow:0 28px 64px rgba(0,0,0,.45); user-select:none">
    <OptimizedImage src="/assets/before-after/ba-02-backyard-large-tree-removal-after.jpg" alt={t("After — the large tree beside the house has been removed")} class="pz-ba" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 968px) calc(100vw - 48px), 920px" style="width:100%; height:480px; object-fit:cover; display:block" />
    <div data-cmp-clip style="position:absolute; inset:0; clip-path:inset(0 52% 0 0); overflow:hidden">
      <OptimizedImage src="/assets/before-after/ba-02-backyard-large-tree-removal-before.jpg" alt={t("Before — a mature tree overhanging the house")} class="pz-ba" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 968px) calc(100vw - 48px), 920px" style="width:100%; height:480px; object-fit:cover; display:block" />
    </div>
    <div style="position:absolute; top:18px; left:18px; background:rgba(8,40,22,.82); color:#fff; padding:6px 14px; border-radius:30px; font-family:'Barlow Semi Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:.08em; font-size:12.5px">{t("Before")}</div>
    <div style="position:absolute; top:18px; right:18px; background:var(--action); color:#241303; padding:6px 14px; border-radius:30px; font-family:'Barlow Semi Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:.08em; font-size:12.5px">{t("After")}</div>
    <div data-cmp-handle style="position:absolute; top:0; bottom:0; left:48%; width:3px; background:#fff; box-shadow:0 0 12px rgba(0,0,0,.5); pointer-events:none; transform:translateX(-1.5px)">
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:46px; height:46px; border-radius:50%; background:#fff; box-shadow:0 4px 14px rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; color:var(--forest); font-weight:700; font-size:17px">&#8646;</div>
    </div>
    <input type="range" data-cmp-range min="0" max="100" value="48" aria-label={t("Drag to compare before and after")} style="position:absolute; bottom:0; left:0; width:100%; height:100%; opacity:0; cursor:ew-resize; margin:0; touch-action:pan-y">
    <div style="position:absolute; bottom:16px; left:50%; transform:translateX(-50%); background:rgba(8,40,22,.7); color:#fff; padding:6px 14px; border-radius:30px; font-size:12.5px; font-weight:600; letter-spacing:.04em; pointer-events:none; white-space:nowrap">{t("← Drag to compare →")}</div>
  </div>

  <figcaption class="pz-project-caption">
    <div><h3>{t("Backyard tree removal")}</h3><p>{t("A mature tree beside the house, before and after removal.")}</p></div>
    <a href="#quote" data-service-select="Tree Removal" class="pz-primary-cta pz-project-cta">{t("Get a tree removal estimate")} <span aria-hidden="true">→</span></a>
  </figcaption>
  </figure>

  <div class="pz-tabs" role="group" aria-label={t("Explore our work")} style="display:flex; justify-content:center; gap:10px; margin:0 auto 32px; flex-wrap:wrap">
    <button type="button" class="pz-tab pz-work-gallery" id="pzTabWork" aria-haspopup="dialog" aria-controls="pzLightbox">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="16" height="16" rx="3"/><path d="M17 21H6a3 3 0 0 1-3-3V7M5 15l5-5 4 4 3-3 4 4"/><circle cx="16" cy="7" r="1"/></svg>
      {t("Recent Work")}
    </button>
    <button type="button" class="pz-tab" id="pzTabBa" aria-controls="pzPanelBa" aria-expanded="false">{t("Before & After")}<svg class="pz-work-chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"/></svg></button>
  </div>

  <div id="pzPanelWork" role="region" aria-label={t("Recent project photos")}>
    <div class="pz-gallery rv rv-rise" id="pzGallery" style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:1080px; margin:0 auto"></div>
  </div>

  <div id="pzPanelBa" role="region" aria-labelledby="pzTabBa" hidden>
    <div class="pz-bagrid" id="pzBaGrid" style="display:grid; grid-template-columns:repeat(2,1fr); gap:22px; max-width:1080px; margin:0 auto"></div>
    <p style="text-align:center; color:#d6d6d6; font-size:14px; margin:26px auto 0; max-width:560px">{t("Drag any slider to compare. Every one of these is a real Paez Tree Service job in Anaheim & Orange County.")}</p>
  </div>
  <div class="pz-gallery-action">
    <button type="button" id="pzViewGallery" class="pz-gallery-cta" data-open-gallery aria-haspopup="dialog" aria-controls="pzLightbox">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="16" height="16" rx="3"/><path d="M17 21H6a3 3 0 0 1-3-3V7M5 15l5-5 4 4 3-3 4 4"/><circle cx="16" cy="7" r="1"/></svg>
      <span>{t("View all photos")}</span><span class="pz-gallery-count" data-gallery-count>72</span>
    </button>
  </div>
  </div>
</section>

<!-- LIGHTBOX -->
<div id="pzLightbox" style="display:none; position:fixed; inset:0; z-index:200; background:rgba(4,16,9,.86); align-items:center; justify-content:center; padding:4vh 4vw; animation:paezFade .22s ease">
  <div class="pz-lb" style="background:var(--paper); width:100%; max-width:1080px; height:88vh; border-radius:14px; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 40px 100px rgba(0,0,0,.6); animation:paezZoom .25s ease">
    <div style="display:flex; align-items:center; justify-content:space-between; padding:15px 22px; border-bottom:1px solid var(--line); background:#fff; flex:none">
      <div style="display:flex; align-items:center; gap:12px">
        <img src="/assets/optimized/yelp-logo-192.webp" alt="Yelp" style="height:22px; width:auto; display:block">
        <span style="width:1px; height:24px; background:var(--line)"></span>
        <span id="pzLbHeading" style="font-family:'Barlow Condensed',sans-serif; font-weight:800; font-size:22px; text-transform:uppercase; color:var(--forest); line-height:1">{t("Photos")}</span>
        <span class="pz-lb-count" style="font-size:13px; color:var(--muted); font-weight:600">{t("72 photos from Paez Tree Service")}</span>
      </div>
      <button type="button" id="pzLbClose" class="pz-lb-x" aria-label={t("Close")} style="width:42px; height:42px; border-radius:50%; background:var(--cream); border:1px solid var(--line); color:var(--forest); font-size:18px; cursor:pointer; display:flex; align-items:center; justify-content:center; flex:none">&#10005;</button>
    </div>
    <div style="flex:1; display:flex; min-height:0">
      <div class="pz-lb-menu" id="pzLbThumbs" style="width:138px; flex:none; border-right:1px solid var(--line); overflow-y:auto; background:#fbf9f1; padding:12px"></div>
      <div class="pz-lb-feed" id="pzLbFeed" style="flex:1; overflow-y:auto; padding:26px 22px; min-width:0; position:relative"></div>
    </div>
  </div>
</div>

<!-- EMERGENCY BAND -->
