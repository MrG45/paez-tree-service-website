---
import { translate, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (text: string) => translate(locale, text);
const alternateLocale = locale === 'en' ? 'es' : 'en';
const alternateLanguage = alternateLocale === 'es' ? 'es-MX' : 'en-US';
const languageLabel = alternateLocale === 'es' ? 'Cambiar a español (México)' : 'Switch to English (US)';
const services = ['Tree Trimming', 'Tree Removal', 'Stump Removal', 'Palm Tree Service', 'HOA & Commercial'];
const explore = [
  ['work', 'Our Work'], ['reviews', 'Reviews'], ['about', 'Our team'],
  ['service-area', 'Service Area'], ['faq', 'FAQs'],
];
---

<footer id="footer" class="pz-footer">
  <div class="pz-footer-inner">
    <div class="pz-footer-top">
      <a href="#main" aria-label={t('Paez Tree Service home')}>
        <img src="/assets/optimized/site/logo-280.webp" width="96" height="67" loading="lazy" decoding="async" alt="Paez Tree Service" class="pz-footer-logo">
      </a>
      <span class="pz-footer-open">{t('Open 24/7')}</span>
    </div>
    <div class="pz-footer-story">
      <h2>{t('Proudly serving Anaheim & Orange County.')}</h2>
      <p>{t('Paez Tree Service provides professional tree trimming, tree removal, stump grinding and palm tree care for local homes, HOAs and businesses. Our owner-led crew takes pride in safe work, respect for your property and a complete cleanup after every job.')}</p>
    </div>
    <div class="pz-footer-contact-dock">
      <div>
        <p>{t('Let’s take care of your trees.')}</p>
        <a class="pz-footer-phone" href="tel:7149269413" aria-label={t('Call (714) 926-9413')}>(714) 926-9413</a>
      </div>
      <a class="pz-footer-estimate" href="#quote">
        {t('Free estimate')}
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
      </a>
    </div>
    <div class="pz-footer-accordions">
      <details open>
        <summary>{t('Tree services')}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <nav class="pz-footer-links" aria-label={t('Tree services')}>
          {services.map(service => <a href="#services">{t(service)}</a>)}
          <a href="tel:7149269413">{t('Emergency help')}</a>
        </nav>
      </details>
      <details>
        <summary>{t('Explore Paez')}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <nav class="pz-footer-links" aria-label={t('Explore Paez')}>
          {explore.map(([id, label]) => <a href={`#${id}`}>{t(label)}</a>)}
        </nav>
      </details>
      <details>
        <summary>{t('Contact & location')}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="pz-footer-contact">
          <address>1705 S State College Blvd<br>Anaheim, CA 92806</address>
          <a href="mailto:paeztreeservices@gmail.com">paeztreeservices@gmail.com</a>
          <a href="https://www.yelp.com/biz/paez-tree-service-anaheim" target="_blank" rel="noopener noreferrer">{t('Read customer reviews on Yelp →')}</a>
        </div>
      </details>
    </div>
    <div class="pz-footer-credential">
      <span class="pz-footer-credential-title">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.3 3 7.5 7.5 9.5 4.5-2 7.5-5.2 7.5-9.5V6L12 3Z"/><path d="m8.5 11.5 2.5 2.5 4.5-5"/></svg>
        <span>{t('CA State License #1089610')}</span>
      </span>
      <span>{t('Insured · Bonded · Workers’ comp')}</span>
    </div>
    <div class="pz-footer-bottom-links">
      <small class="pz-footer-credit"><span>{t('Brought to you by')} </span><a href="https://poweredbylc.com" target="_blank" rel="noopener noreferrer" aria-label="LC Marketing — poweredbylc.com">poweredbylc.com</a></small>
      <a class="pz-footer-dashboard" href="#main">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v2"/></svg>
        <span>{t('Dashboard login')}</span>
      </a>
    </div>
    <div class="pz-footer-legal">
      <span>© {new Date().getFullYear()} Paez Tree Service</span>
      <a href={alternateLocale === 'es' ? '/es/' : '/'} class="pz-footer-language" data-language-link data-lang={alternateLocale} lang={alternateLanguage} hreflang={alternateLanguage} aria-label={languageLabel}>
        <img src={alternateLocale === 'es' ? '/assets/flags/mx.webp' : '/assets/flags/us.svg'} width="20" height="14" alt="" aria-hidden="true">
        <span>{alternateLocale === 'es' ? 'Español' : 'English'}</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .pz-footer { background: var(--brand-green); color: #fff; --footer-muted: #c9d6cc; --footer-line: #ffffff28; }
  .pz-footer-inner { max-width: 1180px; margin: 0 auto; }
  .pz-footer a { color: inherit; text-decoration: none; }
  .pz-footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .pz-footer :is(a, summary):focus-visible { outline: 2px solid var(--action); outline-offset: 4px; }
  .pz-footer svg { flex: none; }
  .pz-footer-top { padding: 30px 32px 16px; display: flex; align-items: center; justify-content: space-between; gap: 15px; }
  .pz-footer-logo { display: block; width: 96px; height: 67px; object-fit: contain; }
  .pz-footer-open { display: flex; align-items: center; gap: 7px; color: var(--action); font-size: 12px; white-space: nowrap; }
  .pz-footer-open::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .pz-footer-story { padding: 0 32px 28px; max-width: 650px; }
  .pz-footer-story h2 { margin: 0 0 10px; font: 600 17px/1.4 'Barlow', sans-serif; }
  .pz-footer-story p { margin: 0; color: var(--footer-muted); font-size: 14px; line-height: 1.65; }
  .pz-footer-contact-dock { padding: 0 32px 26px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 14px; }
  .pz-footer-contact-dock p { margin: 0 0 6px; color: var(--footer-muted); font-size: 13px; }
  .pz-footer-phone { display: inline-flex; align-items: center; min-height: 44px; font: 800 38px/1.1 'Barlow Condensed', sans-serif; white-space: nowrap; }
  .pz-footer a.pz-footer-estimate { min-width: 190px; min-height: 48px; padding: 12px 20px; border-radius: 18px; background: var(--action); color: var(--brand-green); display: flex; justify-content: center; align-items: center; gap: 12px; font-size: 15px; font-weight: 600; text-decoration: none; text-align: center; }
  .pz-footer a.pz-footer-estimate:hover { background: var(--action-hover); }
  .pz-footer-accordions { padding: 0 32px; border-top: 1px solid var(--footer-line); }
  .pz-footer details { border-bottom: 1px solid var(--footer-line); }
  .pz-footer summary { display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 58px; list-style: none; font-size: 15px; font-weight: 600; cursor: pointer; }
  .pz-footer summary::-webkit-details-marker { display: none; }
  .pz-footer details[open] summary svg { transform: rotate(180deg); }
  .pz-footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; padding-bottom: 16px; }
  .pz-footer-links a { display: flex; align-items: center; min-height: 36px; font-size: 14px; }
  .pz-footer-contact { display: grid; gap: 8px; padding: 0 0 20px; color: var(--footer-muted); font-size: 14px; }
  .pz-footer-contact address { font-style: normal; }
  .pz-footer-contact a { display: flex; align-items: center; min-height: 36px; overflow-wrap: anywhere; }
  .pz-footer-credential { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 22px 32px; text-align: center; font-size: 12px; line-height: 1.25; color: var(--footer-muted); }
  .pz-footer-credential-title { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .pz-footer-credential svg { color: var(--action); }
  .pz-footer-bottom-links { padding: 0 32px 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px 20px; flex-wrap: wrap; font-size: 12px; color: var(--footer-muted); }
  .pz-footer-credit { display: flex; align-items: center; flex-wrap: wrap; gap: 0 6px; font: inherit; }
  .pz-footer-credit a { display: inline-flex; align-items: center; min-height: 36px; color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .pz-footer-dashboard { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; }
  .pz-footer-legal { border-top: 1px solid var(--footer-line); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; color: var(--footer-muted); font-size: 12px; }
  .pz-footer-language { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-size: 13px; }
  .pz-footer-language img { display: block; object-fit: cover; border-radius: 2px; }
  @media (max-width: 619px) {
    .pz-footer-top { padding: 26px 24px 22px; }
    .pz-footer-story { padding: 0 24px 26px; }
    .pz-footer-contact-dock { grid-template-columns: 1fr; padding: 0 24px 26px; }
    .pz-footer-accordions { padding: 0 24px; }
    .pz-footer-credential { padding: 22px 24px; }
    .pz-footer-bottom-links { padding: 0 24px 18px; }
    .pz-footer-legal { padding: 16px 24px; }
  }
  @media (max-width: 340px) { .pz-footer-phone { font-size: 34px; } }
  @media (pointer: coarse) { .pz-footer-links a, .pz-footer-contact a, .pz-footer-bottom-links a { min-height: 44px; } }
</style>
