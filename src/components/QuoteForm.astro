---
import { translate, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (text: string) => translate(locale, text);
---
<div id="quote" class="pz-quote" tabindex="-1" aria-labelledby="pz-quote-title">
  <div class="pz-quote-heading">
    <svg viewBox="0 0 24 24" width="120" height="120" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="position:absolute; top:-26px; right:-24px; opacity:.16; transform:rotate(18deg)"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
    <h2 id="pz-quote-title" style="font-family:'Barlow Condensed',sans-serif; font-weight:800; color:#fff; font-size:28px; line-height:1.15; text-transform:uppercase; letter-spacing:.02em; position:relative; margin:0">{t("Free Estimate")}</h2>
    <div class="pz-quote-subtitle" style="color:#fff; font-size:14px; font-weight:600; margin-top:3px; position:relative">{t("Two short steps. No obligation.")}</div>
  </div>
  <p id="pzOfferApplied" class="pz-offer-applied" role="status" hidden>{t("WEB10 added: 10% discount requested. Paez will confirm the offer details.")}</p>
  <form id="pzQuoteForm" method="post" action="https://n8n.srv1351927.hstgr.cloud/webhook/paez-quote" novalidate>
    <input type="hidden" name="language" value={locale}>
    <input type="hidden" name="form_version" value="2">
    <div class="pz-form-progress" aria-label={t("Estimate request progress")}>
      <span data-progress-step="1" aria-current="step"><b aria-hidden="true">1</b> {t("Your tree project")}</span>
      <span data-progress-step="2"><b aria-hidden="true">2</b> {t("Your contact details")}</span>
    </div>
    <p id="pzEmergencyNote" class="pz-emergency-note" role="status" hidden>{t("Urgent tree hazard? Call now for the fastest help:")} <a href="tel:7149269413">(714) 926-9413</a>. {t("Do not wait for an online reply.")}</p>
    <section class="pz-form-step" data-form-step="1" aria-labelledby="pz-step-1-title">
      <h3 id="pz-step-1-title" class="pz-form-step-title" tabindex="-1">{t("Choose your main service")}</h3>
      <fieldset class="pz-service-fieldset" aria-describedby="pz-service-error">
        <legend class="pz-sr-only">{t("Choose your main service")} <span aria-hidden="true">*</span></legend>
        <div class="pz-service-options">
          {[
            ["Tree Trimming", "Trim & prune", "Shape trees & clear branches"],
            ["Tree Removal", "Remove a tree", "Safe, complete removal"],
            ["Stump Removal", "Remove a stump", "Reclaim your yard"],
            ["Palm Tree Service", "Palm tree care", "Trim, skin & clean palms"]
          ].map(([value, label, hint], index) => (
            <label class="pz-service-option" for={`pz-service-${index}`}>
              <input id={`pz-service-${index}`} type="radio" name="service" value={value} required aria-describedby="pz-service-error">
              <span><strong>{t(label)}</strong><small>{t(hint)}</small></span>
            </label>
          ))}
        </div>
        <p id="pz-service-error" class="pz-field-error" hidden></p>
      </fieldset>
      <div class="pz-form-row pz-tree-size-row">
        <div class="pz-field">
          <label class="pz-field-label" for="pz-tree_count" data-tree-count-label>{t("How many trees?")}</label>
          <select id="pz-tree_count" name="tree_count" class="pz-in pz-field-control">
            {[["Not sure", "Not sure"], ["1", "1"], ["2–3", "2–3"], ["4–6", "4–6"], ["7+", "7+"]].map(([value, label]) => <option value={value}>{t(label)}</option>)}
          </select>
        </div>
        <div class="pz-field" data-tree-height-field>
          <label class="pz-field-label" for="pz-tree_height">{t("Approx. height")}</label>
          <select id="pz-tree_height" name="tree_height" class="pz-in pz-field-control">
            {[["Not sure", "Not sure"], ["Under 15 ft", "Under 15 ft"], ["15–30 ft", "15–30 ft"], ["30–50 ft", "30–50 ft"], ["Over 50 ft", "Over 50 ft"]].map(([value, label]) => <option value={value}>{t(label)}</option>)}
          </select>
        </div>
      </div>
      <div class="pz-field">
          <label class="pz-field-label" for="pz-timeline">{t("When do you need help?")}</label>
          <select id="pz-timeline" name="timeline" class="pz-in pz-field-control">
            <option value="Flexible">{t("I'm flexible")}</option>
            <option value="As soon as possible">{t("As soon as possible")}</option>
            <option value="Emergency">{t("Emergency — urgent hazard")}</option>
            <option value="This week">{t("This week")}</option>
            <option value="Within a month">{t("Within a month")}</option>
          </select>
      </div>
      <button type="button" class="pz-form-next pz-primary-cta" data-form-next>{t("Next: contact details →")}</button>
    </section>
    <section class="pz-form-step" data-form-step="2" aria-labelledby="pz-step-2-title" hidden>
      <h3 id="pz-step-2-title" class="pz-form-step-title" tabindex="-1">{t("Where should we reach you?")}</h3>
      <div id="pzRequestSummary" class="pz-request-summary" aria-label={t("Your request summary")}>
        <div class="pz-summary-header"><strong>{t("Your tree project")}</strong><button type="button" data-summary-edit>{t("Edit project")}</button></div>
        <dl>
          <div><dt>{t("Service")}</dt><dd data-summary-service></dd></div>
          <div><dt data-summary-count-label>{t("Trees")}</dt><dd data-summary-count></dd></div>
          <div data-summary-height-row><dt>{t("Height")}</dt><dd data-summary-height></dd></div>
          <div><dt>{t("Timing")}</dt><dd data-summary-timeline></dd></div>
        </dl>
      </div>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-name">{t("Full name")} <span aria-hidden="true">*</span></label>
        <input id="pz-name" type="text" name="name" class="pz-in pz-field-control" autocomplete="name" maxlength="100" placeholder={t("Full name")} aria-describedby="pz-name-error" required>
        <p id="pz-name-error" class="pz-field-error" hidden></p>
      </div>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-phone">{t("Phone number")} <span aria-hidden="true">*</span></label>
        <input id="pz-phone" type="tel" name="phone" class="pz-in pz-field-control" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="(714) 555-0123" aria-describedby="pz-phone-error" required>
        <p id="pz-phone-error" class="pz-field-error" hidden></p>
      </div>
      <fieldset class="pz-contact-preference">
        <legend class="pz-field-label">{t("How should we contact you?")}</legend>
        <label><input type="radio" name="contact_preference" value="Call" checked> {t("Call me")}</label>
        <label><input type="radio" name="contact_preference" value="Text"> {t("Text me")}</label>
      </fieldset>
      <fieldset class="pz-property-address" aria-describedby="pz-address-help">
        <legend>{t("Property address")}</legend>
        <p id="pz-address-help">{t("Where are the trees? Enter the address where the work is needed.")}</p>
        <div class="pz-field">
          <label class="pz-field-label" for="pz-street_address">{t("Street address")} <span aria-hidden="true">*</span></label>
          <input id="pz-street_address" type="text" name="street_address" class="pz-in pz-field-control" autocomplete="section-property address-line1" maxlength="160" placeholder={t("House number and street name")} aria-describedby="pz-street_address-error" required>
          <p id="pz-street_address-error" class="pz-field-error" hidden></p>
        </div>
        <div class="pz-field">
          <label class="pz-field-label" for="pz-address_line2">{t("Apt, unit or suite (optional)")}</label>
          <input id="pz-address_line2" type="text" name="address_line2" class="pz-in pz-field-control" autocomplete="section-property address-line2" maxlength="80" aria-describedby="pz-address_line2-error">
          <p id="pz-address_line2-error" class="pz-field-error" hidden></p>
        </div>
        <div class="pz-address-city-row">
          <div class="pz-field">
            <label class="pz-field-label" for="pz-city">{t("City")} <span aria-hidden="true">*</span></label>
            <input id="pz-city" type="text" name="city" class="pz-in pz-field-control" autocomplete="section-property address-level2" maxlength="100" aria-describedby="pz-city-error" required>
            <p id="pz-city-error" class="pz-field-error" hidden></p>
          </div>
          <div class="pz-field">
            <label class="pz-field-label" for="pz-state">{t("State")}</label>
            <input id="pz-state" type="text" name="state" class="pz-in pz-field-control" autocomplete="section-property address-level1" value="CA" readonly aria-describedby="pz-state-error" required>
            <p id="pz-state-error" class="pz-field-error" hidden></p>
          </div>
        </div>
        <div class="pz-field">
          <label class="pz-field-label" for="pz-postal_code">{t("ZIP code")} <span aria-hidden="true">*</span></label>
          <input id="pz-postal_code" type="text" name="postal_code" class="pz-in pz-field-control" autocomplete="section-property postal-code" inputmode="numeric" maxlength="10" placeholder={t("e.g. 92806")} aria-describedby="pz-postal_code-error" required>
          <p id="pz-postal_code-error" class="pz-field-error" hidden></p>
        </div>
      </fieldset>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-property_type">{t("Property type (optional)")}</label>
        <select id="pz-property_type" name="property_type" class="pz-in pz-field-control">
          <option value="">{t("Select property type")}</option>
          <option value="Home">{t("Home")}</option>
          <option value="HOA / Commercial">{t("HOA / Commercial")}</option>
        </select>
      </div>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-email">{t("Email (optional)")}</label>
        <input id="pz-email" type="email" name="email" class="pz-in pz-field-control" autocomplete="email" maxlength="254" placeholder={t("For estimate details")} aria-describedby="pz-email-error">
        <p id="pz-email-error" class="pz-field-error" hidden></p>
      </div>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-discount_code">{t("Discount code (optional)")}</label>
        <input id="pz-discount_code" type="text" name="discount_code" class="pz-in pz-field-control" maxlength="32" autocapitalize="characters" spellcheck="false" autocomplete="off" placeholder={t("Enter a code")} aria-describedby="pz-discount-help pz-discount_code-error">
        <p id="pz-discount-help" class="pz-field-help">{t("Have an offer? Add your code. Paez will confirm eligibility with your estimate.")}</p>
        <p id="pz-discount_code-error" class="pz-field-error" hidden></p>
      </div>
      <div class="pz-field">
        <label class="pz-field-label" for="pz-details">{t("Anything we should know? (optional)")}</label>
        <textarea id="pz-details" name="details" class="pz-in pz-field-control" maxlength="2000" placeholder={t("Near a roof or power lines? Tell us about access, hazards or your goals.")} rows="2"></textarea>
      </div>
      <p class="pz-next-step-note">{t("Paez will call or text you, as requested, to discuss the job and arrange your free estimate visit.")}</p>
      <p class="pz-form-consent">{t("By requesting an estimate, you agree that Paez Tree Service may call or text you about this request. We use your details to arrange your estimate and basic visit information to understand how you found us.")}</p>
      <div class="pz-form-actions">
        <button type="button" class="pz-form-back" data-form-back>{t("← Back")}</button>
        <button type="submit" class="pz-primary-cta pz-form-submit">{t("Request my free estimate →")}</button>
      </div>
    </section>
    <div class="pz-form-honeypot" aria-hidden="true" inert>
      <label for="pz-website">Website</label><input id="pz-website" type="text" name="website" tabindex="-1" autocomplete="off">
    </div>
    <div id="pzFormStatus" class="pz-form-status" role="status" aria-live="polite"></div>
    <div class="pz-form-call">{t("Prefer to talk? Call")} <a href="tel:7149269413">(714) 926-9413</a></div>
    <noscript><p>{t("Please call (714) 926-9413 for your free estimate. The online form needs JavaScript.")}</p></noscript>
  </form>
  <div id="pzFormSuccess" class="pz-form-success" hidden tabindex="-1">
    <span aria-hidden="true">✓</span>
    <h3>{t("Request received")}</h3>
    <p id="pzSuccessMessage">{t("Thank you. Paez will contact you to arrange your estimate.")}</p>
    <p>{t("Next, we will discuss your trees and agree on a time to visit. No work is scheduled until you confirm it with Paez.")}</p>
    <p>{t("Need help now? Call")} <a href="tel:7149269413">(714) 926-9413</a>.</p>
  </div>
  <div class="pz-quote-proof">
    <blockquote><p>“{t("Their quote was very fair and service was quick and professional.")}”</p></blockquote>
    <p class="pz-review-credit">Huy Tran · {t("December 14, 2025")}{locale === 'es' && <span> · {t("Translated from English")}</span>}</p>
    <a href="https://www.yelp.com/biz/paez-tree-service-anaheim" target="_blank" rel="noopener">{t("Read customer reviews on Yelp →")}</a>
  </div>
</div>

<style>
  /* Keep the first decision short enough for laptop screens. */
  #quote{flex:none;width:100%;min-width:0;background:var(--paper);border-radius:16px;box-shadow:0 16px 40px rgba(0,0,0,.2);overflow:hidden;animation:paezRise .6s ease both .12s}
  .pz-quote-heading{background:linear-gradient(150deg,#124a28,#0a2b15);padding:16px 22px;position:relative;overflow:hidden}
  #pzQuoteForm{padding:18px 22px 20px;display:flex;flex-direction:column;gap:12px;margin:0}
  #quote .pz-form-progress{font-family:'Barlow',sans-serif;font-size:13px;gap:10px;margin:0}
  #quote .pz-form-progress>span{padding-bottom:8px;gap:6px}
  #quote .pz-form-step{gap:12px}
  #quote .pz-form-step>h3{font-family:'Barlow',sans-serif;font-size:19px;font-weight:700;line-height:1.25}
  #quote .pz-service-option{font-family:'Barlow',sans-serif;font-size:15px;line-height:1.25;padding:10px;min-height:72px;gap:8px;align-items:center}
  #quote .pz-service-option strong{font-weight:600}
  #quote .pz-service-option small{font-size:14px;font-weight:500;line-height:1.3;margin-top:4px;color:#4d4d4d}
  #quote .pz-service-option:has(input:checked) small{color:#fff}
  #quote .pz-field-label{font-size:14px;line-height:1.3;margin-bottom:5px}
  #quote .pz-form-next,#quote .pz-form-actions button{font-family:'Barlow',sans-serif;font-size:15px;font-weight:600;letter-spacing:0;text-transform:none;min-height:48px;padding:11px 16px;border-radius:30px;box-shadow:none}
  #quote .pz-form-next,#quote .pz-form-submit{background:var(--action);color:var(--brand-green)}
  #quote .pz-form-call{padding-top:10px;margin-top:0;font-size:13px}
  #quote .pz-form-call a{font-size:15px}
  #quote .pz-emergency-note{margin:0}
  #quote .pz-quote-proof{padding:14px 22px;font-size:13px}
  #quote .pz-quote-proof blockquote p{font-size:14px;line-height:1.4;margin-bottom:5px}
  #quote .pz-quote-proof a{min-height:32px}
  #quote .pz-review-credit{font-size:12px}
  #quote .pz-property-address{display:grid;gap:12px;min-width:0;margin:4px 0 0;padding:16px 0 0;border:0;border-top:1px solid #d8d8d8}
  #quote .pz-property-address legend{float:left;width:100%;padding:0;font-size:17px;font-weight:700;color:var(--forest)}
  #quote .pz-property-address>p{margin:0;font-size:14px;line-height:1.4;color:#4d4d4d}
  #quote .pz-address-city-row{display:grid;grid-template-columns:minmax(0,1fr) 76px;gap:12px}
  #quote .pz-field-control[readonly]{background:#ededed;color:#4d4d4d}
  #quote .pz-field-help{font-size:12px;line-height:1.4;margin:6px 0 0;color:#4d4d4d}
  #quote #pz-discount_code{text-transform:uppercase;letter-spacing:.06em}
  #quote .pz-tree-size-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  #quote .pz-tree-size-row:has([data-tree-height-field][hidden]){grid-template-columns:1fr}
  @media(max-width:760px){
    .pz-quote-heading{padding:18px 20px}
    #pzQuoteForm{padding:18px 20px 22px}
  }
  @media(max-width:400px){
    #pzQuoteForm{padding-left:16px;padding-right:16px}
    #quote .pz-service-options{grid-template-columns:1fr 1fr}
    #quote .pz-service-option{font-size:14px;padding:9px 8px;gap:6px;align-items:flex-start}
    #quote .pz-service-option small{display:none}
    #quote .pz-service-option input{margin-top:2px}
    #quote .pz-form-progress{font-size:12px}
    #quote .pz-form-row{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){#quote{animation:none}}
</style>
